<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="stock_package_view_form_neoship" model="ir.ui.view">
        <field name="name">stock.package.form.neoship</field>
        <field name="model">stock.package</field>
        <field name="inherit_id" ref="stock.stock_package_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group" position="after">
                <group name="neoship_data" string="Neoship" invisible="not neoship_parcel_ids">
                    <field name="neoship_parcel_ids" nolabel="1" colspan="2">
                        <list>
                            <field name="picking_id"/>
                            <field name="tracking_ref"/>
                            <field name="reference"/>
                            <field name="neoship_id" options="{'enable_formatting': false}"/>
                            <field name="status"/>
                            <field name="status_group" widget="badge" decoration-success="status_group == 'delivered'" decoration-danger="status_group in ('notdelivered', 'returned')" decoration-info="status_group == 'transit'"/>
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
