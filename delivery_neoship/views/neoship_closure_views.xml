<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_neoship_closure_list" model="ir.ui.view">
        <field name="name">neoship.closure.list</field>
        <field name="model">neoship.closure</field>
        <field name="arch" type="xml">
            <list create="false" decoration-danger="state == 'failed'" decoration-muted="state == 'empty'">
                <field name="closed_at"/>
                <field name="carrier_id"/>
                <field name="shipper_name"/>
                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-danger="state == 'failed'"/>
                <field name="message" optional="show"/>
                <field name="prod_environment" optional="hide"/>
                <field name="protocol_filename" column_invisible="True"/>
                <field name="protocol" widget="binary" filename="protocol_filename"/>
            </list>
        </field>
    </record>

    <record id="view_neoship_closure_form" model="ir.ui.view">
        <field name="name">neoship.closure.form</field>
        <field name="model">neoship.closure</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="carrier_id"/>
                            <field name="shipper_name"/>
                            <field name="schedule_id" groups="base.group_system"/>
                            <field name="prod_environment"/>
                        </group>
                        <group>
                            <field name="closed_at"/>
                            <field name="closure_date"/>
                            <field name="date_from" invisible="not date_from"/>
                            <field name="state" widget="badge" decoration-success="state == 'done'" decoration-danger="state == 'failed'"/>
                            <field name="protocol_filename" invisible="1"/>
                            <field name="protocol" filename="protocol_filename" invisible="not protocol"/>
                        </group>
                    </group>
                    <field name="message" invisible="not message"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_neoship_closure_search" model="ir.ui.view">
        <field name="name">neoship.closure.search</field>
        <field name="model">neoship.closure</field>
        <field name="arch" type="xml">
            <search>
                <field name="carrier_id"/>
                <field name="shipper_name"/>
                <filter name="done" string="Closed" domain="[('state', '=', 'done')]"/>
                <filter name="failed" string="Failed" domain="[('state', '=', 'failed')]"/>
                <separator/>
                <filter name="closed_at" date="closed_at"/>
                <group>
                    <filter name="group_carrier" string="Delivery Method" context="{'group_by': 'carrier_id'}"/>
                    <filter name="group_state" string="Result" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_neoship_closure" model="ir.actions.act_window">
        <field name="name">Neoship Protocols</field>
        <field name="res_model">neoship.closure</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No Neoship protocols yet</p>
            <p>Closures are created by the closure schedules in Inventory configuration.</p>
        </field>
    </record>

    <record id="view_neoship_closure_schedule_list" model="ir.ui.view">
        <field name="name">neoship.closure.schedule.list</field>
        <field name="model">neoship.closure.schedule</field>
        <field name="arch" type="xml">
            <list>
                <field name="carrier_id"/>
                <field name="shipper_name"/>
                <field name="closure_time" widget="float_time"/>
                <field name="next_run"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_neoship_closure_schedule_form" model="ir.ui.view">
        <field name="name">neoship.closure.schedule.form</field>
        <field name="model">neoship.closure.schedule</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_close_now" type="object" string="Close Now" class="btn-primary" invisible="not id" confirm="Close all shipments of this Neoship account at this carrier now?"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_closures" type="object" class="oe_stat_button" icon="fa-list">
                            <field name="closure_count" widget="statinfo" string="Protocols"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="alert alert-info" role="alert">
                        The closure covers all shipments of the Neoship account at this carrier, including shipments not sent from Odoo.
                    </div>
                    <group>
                        <group>
                            <field name="carrier_id" options="{'no_create': True}"/>
                            <field name="shipper_name"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="closure_time" widget="float_time"/>
                            <label for="mon" string="Days"/>
                            <div>
                                <field name="mon" invisible="1"/>
                                <widget name="week_days"/>
                            </div>
                            <field name="tz"/>
                            <field name="next_run" invisible="not id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_neoship_closure_schedule" model="ir.actions.act_window">
        <field name="name">Neoship Closure Schedules</field>
        <field name="res_model">neoship.closure.schedule</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Schedule a Neoship closure</p>
            <p>Close the day at SPS, Packeta or Slovenská pošta automatically and keep the protocol in Odoo.</p>
        </field>
    </record>

    <menuitem id="menu_neoship_closure" action="action_neoship_closure" parent="stock.menu_stock_transfers" sequence="50"/>
    <menuitem id="menu_neoship_closure_schedule" action="action_neoship_closure_schedule" parent="stock.menu_delivery" groups="base.group_system" sequence="5"/>
    <menuitem id="menu_neoship_closure_config" action="action_neoship_closure" parent="stock.menu_delivery" sequence="6"/>
</odoo>
