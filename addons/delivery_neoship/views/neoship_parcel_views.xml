<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="neoship_parcel_view_list" model="ir.ui.view">
        <field name="name">neoship.parcel.list</field>
        <field name="model">neoship.parcel</field>
        <field name="arch" type="xml">
            <list create="false" delete="false">
                <field name="picking_id"/>
                <field name="tracking_ref"/>
                <field name="package_id" optional="show"/>
                <field name="cod_amount" optional="show"/>
                <field name="status"/>
                <field name="status_group" widget="badge" decoration-success="status_group == 'delivered'" decoration-danger="status_group in ('notdelivered', 'returned')" decoration-info="status_group == 'transit'"/>
                <field name="status_date" optional="hide"/>
                <button name="action_open_label" type="object" string="Label" icon="fa-file-pdf-o"/>
                <button name="action_open_tracking" type="object" string="Tracking" icon="fa-truck" invisible="not tracking_ref"/>
            </list>
        </field>
    </record>

    <record id="neoship_parcel_view_form" model="ir.ui.view">
        <field name="name">neoship.parcel.form</field>
        <field name="model">neoship.parcel</field>
        <field name="arch" type="xml">
            <form create="false" delete="false">
                <sheet>
                    <group>
                        <group name="shipment">
                            <field name="picking_id"/>
                            <field name="package_id" invisible="not package_id"/>
                            <field name="tracking_ref"/>
                            <field name="reference"/>
                            <field name="neoship_id"/>
                            <field name="prod_environment"/>
                            <field name="is_copy" invisible="not is_copy"/>
                            <field name="cod_amount"/>
                            <field name="label_id" invisible="not label_id"/>
                        </group>
                        <group name="tracking">
                            <field name="status"/>
                            <field name="status_group" widget="badge" invisible="not status_group" decoration-success="status_group == 'delivered'" decoration-danger="status_group in ('notdelivered', 'returned')" decoration-info="status_group == 'transit'"/>
                            <field name="status_date" invisible="not status_date"/>
                            <field name="last_sync" invisible="not last_sync"/>
                            <field name="sync_error" invisible="not sync_error"/>
                            <field name="error" invisible="not error"/>
                            <field name="cancel_refused" invisible="not cancel_refused"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
