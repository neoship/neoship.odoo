<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_picking_form_neoship" model="ir.ui.view">
        <field name="name">stock.picking.form.neoship</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock_delivery.view_picking_withcarrier_out_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='carrier_data']" position="after">
                <group name="neoship_data" string="Neoship" invisible="delivery_type != 'neoship'">
                    <field name="neoship_status" invisible="not neoship_parcel_ids"/>
                    <field name="neoship_status_group" widget="badge" invisible="not neoship_status_group" decoration-success="neoship_status_group == 'delivered'" decoration-danger="neoship_status_group in ('notdelivered', 'returned')" decoration-info="neoship_status_group == 'transit'"/>
                    <field name="neoship_cod_manual" readonly="neoship_parcel_ids"/>
                    <field name="neoship_cod_manual_amount" invisible="not neoship_cod_manual" readonly="neoship_parcel_ids"/>
                    <field name="neoship_parcel_ids" invisible="not neoship_parcel_ids" nolabel="1" colspan="2">
                        <list>
                            <field name="tracking_ref"/>
                            <field name="package_id" optional="show"/>
                            <field name="cod_amount" optional="show"/>
                            <field name="status"/>
                            <field name="status_group" widget="badge" decoration-success="status_group == 'delivered'" decoration-danger="status_group in ('notdelivered', 'returned')" decoration-info="status_group == 'transit'"/>
                            <field name="status_date" optional="hide"/>
                            <field name="last_sync" optional="hide"/>
                            <field name="reference" optional="hide"/>
                            <field name="neoship_id" optional="hide"/>
                            <field name="sync_error" optional="show"/>
                            <field name="error" optional="show"/>
                        </list>
                    </field>
                    <button name="action_neoship_download_label" type="object" string="Download Label Again" icon="fa-download" class="btn-link" invisible="not neoship_parcel_ids" colspan="2"/>
                    <button name="action_neoship_update_tracking" type="object" string="Update Tracking" icon="fa-refresh" class="btn-link" invisible="not neoship_parcel_ids" colspan="2"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="vpicktree_neoship" model="ir.ui.view">
        <field name="name">stock.picking.list.neoship</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock_delivery.vpicktree_view_tree"/>
        <field name="arch" type="xml">
            <field name="carrier_tracking_ref" position="after">
                <field name="neoship_status_group" widget="badge" optional="show" column_invisible="context.get('restricted_picking_type_code') == 'incoming'" decoration-success="neoship_status_group == 'delivered'" decoration-danger="neoship_status_group in ('notdelivered', 'returned')" decoration-info="neoship_status_group == 'transit'"/>
                <field name="neoship_status" optional="hide" column_invisible="context.get('restricted_picking_type_code') == 'incoming'"/>
            </field>
        </field>
    </record>

    <record id="view_picking_internal_search_neoship" model="ir.ui.view">
        <field name="name">stock.picking.search.neoship</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search"/>
        <field name="arch" type="xml">
            <filter name="backorder" position="after">
                <separator/>
                <filter name="neoship_new" string="Neoship: New" domain="[('neoship_status_group', '=', 'new')]"/>
                <filter name="neoship_exported" string="Neoship: Exported" domain="[('neoship_status_group', '=', 'exported')]"/>
                <filter name="neoship_transit" string="Neoship: In Transit" domain="[('neoship_status_group', '=', 'transit')]"/>
                <filter name="neoship_delivered" string="Neoship: Delivered" domain="[('neoship_status_group', '=', 'delivered')]"/>
                <filter name="neoship_not_delivered" string="Neoship: Not Delivered" domain="[('neoship_status_group', '=', 'notdelivered')]"/>
                <filter name="neoship_returned" string="Neoship: Returned" domain="[('neoship_status_group', '=', 'returned')]"/>
                <filter name="neoship_cancel" string="Neoship: Cancelled" domain="[('neoship_status_group', '=', 'cancel')]"/>
            </filter>
            <group position="inside">
                <filter name="group_neoship_status_group" string="Neoship Delivery" context="{'group_by': 'neoship_status_group'}"/>
            </group>
        </field>
    </record>
</odoo>
