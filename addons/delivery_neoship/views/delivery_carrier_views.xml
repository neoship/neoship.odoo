<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_delivery_carrier_form_neoship" model="ir.ui.view">
        <field name="name">delivery.carrier.form.neoship</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="attributes">
                <attribute name="required">delivery_type != 'neoship'</attribute>
            </xpath>
            <xpath expr="//field[@name='fixed_price']" position="attributes">
                <attribute name="invisible">delivery_type not in ('fixed', 'neoship')</attribute>
            </xpath>
            <div name="button_box" position="inside">
                <button name="action_neoship_view_closure_schedules" type="object" class="oe_stat_button" icon="fa-clock-o" groups="base.group_system" invisible="delivery_type != 'neoship'">
                    <field name="neoship_closure_schedule_count" widget="statinfo" string="Closure Schedules"/>
                </button>
            </div>
            <xpath expr="//notebook" position="inside">
                <page string="Neoship Configuration" name="neoship_configuration" invisible="delivery_type != 'neoship'">
                    <group>
                        <group name="neoship_credentials" string="Account" groups="base.group_system">
                            <field name="neoship_username" required="delivery_type == 'neoship'"/>
                            <field name="neoship_password" password="True" required="delivery_type == 'neoship'"/>
                            <button name="action_neoship_test_connection" type="object" string="Test Connection" icon="fa-plug" class="btn-secondary" colspan="2"/>
                        </group>
                        <group name="neoship_shipping" string="Shipping">
                            <field name="neoship_shipper_id" invisible="1"/>
                            <field name="neoship_has_carrier_type" invisible="1"/>
                            <label for="neoship_shipper_name"/>
                            <div class="o_row">
                                <field name="neoship_shipper_name" placeholder="Not selected"/>
                                <button name="action_neoship_choose_shipper" type="object" string="Choose" icon="fa-list" class="btn-link"/>
                            </div>
                            <label for="neoship_default_weight"/>
                            <div class="o_row">
                                <field name="neoship_default_weight"/>
                                <field name="weight_uom_name" nolabel="1"/>
                            </div>
                            <field name="neoship_carrier_type" invisible="1"/>
                            <label for="neoship_carrier_type_name" invisible="not neoship_has_carrier_type"/>
                            <div class="o_row" invisible="not neoship_has_carrier_type">
                                <field name="neoship_carrier_type_name" placeholder="Not selected" required="neoship_has_carrier_type"/>
                                <button name="action_neoship_choose_carrier_type" type="object" string="Choose" icon="fa-list" class="btn-link"/>
                            </div>
                            <field name="neoship_carrier_type_country_id" invisible="not neoship_has_carrier_type"/>
                        </group>
                    </group>
                    <group name="neoship_cod" string="Cash on Delivery">
                        <field name="neoship_cod_domain" widget="domain" options="{'model': 'sale.order', 'in_dialog': True}"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
