<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
    <record id="ir_cron_neoship_update_tracking" model="ir.cron">
        <field name="name">Neoship: Update Tracking</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="state">code</field>
        <field name="code">model._cron_neoship_update_tracking()</field>
        <field name="interval_number" eval="3"/>
        <field name="interval_type">hours</field>
        <!-- 30 minutes after the Neoship status imports (SPS 03:00, Packeta 06:00, external carriers every 3 h, UTC) -->
        <field name="nextcall" eval="DateTime.now().strftime('%Y-%m-%d 00:30:00')"/>
    </record>

    <!-- Each schedule triggers this cron at its next run; the hourly interval catches a missed trigger. -->
    <record id="ir_cron_neoship_closures" model="ir.cron">
        <field name="name">Neoship: Closures</field>
        <field name="model_id" ref="model_neoship_closure_schedule"/>
        <field name="state">code</field>
        <field name="code">model._cron_run_closures()</field>
        <field name="interval_number" eval="1"/>
        <field name="interval_type">hours</field>
    </record>

    <record id="config_parameter_tracking_days" model="ir.config_parameter">
        <field name="key">delivery_neoship.tracking_days</field>
        <field name="value">30</field>
    </record>
</odoo>
